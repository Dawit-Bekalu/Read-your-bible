<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#F9F9F9">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="የዕለቱ የመጽሐፍ ቅዱስ ቃል"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1A237E"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tvVerseReference"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ዮሐንስ 3:16"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#D32F2F"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvVerseText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="በእርሱ የሚያምን ሁሉ የዘላለም ሕይወት እንዲኖረው እንጂ እንዳይጠፋ እግዚአብሔር አንድያ ልጁን እስኪሰጥ ድረስ ዓለሙን እንዲሁ ወዶአልና።"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        android:textColor="#333333"
        android:textAlignment="center"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="2dp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnNextVerse"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ሌላ ጥቅስ ቀይር"
        android:textSize="16sp"
        android:backgroundTint="#1A237E"
        android:textColor="#FFFFFF"
        android:paddingLeft="24dp"
        android:paddingRight="24dp" />

</LinearLayout>
